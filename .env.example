# Database (defaults to SQLite at ./snlag.db when unset)
# DATABASE_URL=postgresql://user:pass@localhost:5432/snlag

# JWT signing key (required in production)
SECRET_KEY=change-me-in-production

# Default admin account created on first startup when no users exist
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# API Gateway -> Orchestration routing (used by ui_layer/api_gateway/gateway.py)
ORCHESTRATION_SERVICE_URL=http://localhost:8000
ORCHESTRATION_WS_URL=ws://localhost:8000
